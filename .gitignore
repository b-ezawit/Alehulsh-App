# AI working files — never commit (CLAUDE.md §22)
CLAUDE.md
.ai/
generated/
.tmp/

# Task tracking — working documents, they drift the moment ClickUp is updated
alehulsh-tasks.xlsx
alehulsh-technical.xlsx
alehulsh-*.csv

# Build artefacts
*.apk
*.aab
*.keystore
*.jks
key.properties

# Secrets
.env
.env.*
# Cloudflare Workers local secrets. `.dev.vars` is where wrangler reads
# development credentials from, so it is the file real Supabase and R2 keys
# would land in. It must never be tracked.
.dev.vars
.dev.vars.*
# wrangler's local state, caches and generated types
.wrangler/

# Build output
dist/

# Local tooling
.venv/
node_modules/
.DS_Store

# Working documents kept LOCAL, not version-controlled (your call, B).
# These hold analysis, decisions and plans rather than product documentation;
# the repository deliberately gains no new markdown from them. Nothing in
# src/, db/ or test/ references them, so the tree stands on its own.
# They exist only on this machine — there is no git history to recover them
# from, so they belong in a backup, not here.
Alehulsh-App/docs/abandoned-task-monitoring.md
Alehulsh-App/docs/alert-transition-guard.md
Alehulsh-App/docs/api-only-migration-plan.md
Alehulsh-App/docs/audit-trail-retention-memo.md
Alehulsh-App/docs/fresh-fix-threshold.md
Alehulsh-App/docs/hosting-compatibility-checklist.md
Alehulsh-App/docs/identity-architecture-decision.md
Alehulsh-App/docs/overdue-pending-tasks.md
Alehulsh-App/docs/task-queue.md

# Development trust anchors, supplied by the operator.
/Alehulsh-App/api/.dev-certs/

# Public mobile build inputs are local and environment-specific. Never point a
# development build at production by copying a backend secret file.
/Alehulsh-App/config/mobile.*.json
!/Alehulsh-App/config/mobile.*.example.json
# These templates contain names and empty slots only, never credentials.
!/Alehulsh-App/api/.dev.vars.example
!/Alehulsh-App/api/.dev.vars.production.example

# Generated audit output and historical working reports stay local.
/audit-output/
/Alehulsh-App/docs/development-migration-plan.md
/Alehulsh-App/docs/migration-integration-status.md
