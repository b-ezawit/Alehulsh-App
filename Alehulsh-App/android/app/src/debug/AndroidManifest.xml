<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only: permit cleartext to the Android emulator's host loopback
         alias so the Firebase Auth emulator (plain HTTP) is reachable.
         Merged into debug builds only; the release manifest is untouched and
         keeps Android's cleartext-blocked default.
         See res/xml/network_security_config.xml. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
